/*
 * GENERATED by kbsync from shared/layout/base.yaml + boards/typeractive-prospector.yaml.
 * Layout: corne-base-fall-26. Edit those files and run `kbsync gen typeractive-prospector`;
 * hand edits here are overwritten.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <40>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };
        combo_tab {
            timeout-ms = <40>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };
        combo_bspc {
            timeout-ms = <40>;
            key-positions = <9 10>;
            bindings = <&kp BSPC>;
        };
        combo_sqt {
            timeout-ms = <40>;
            key-positions = <21 22>;
            bindings = <&kp SQT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_qwerty {
            display-name = "qwerty";
            bindings = <
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
&kp LCTRL  &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp ESC
                                 &kp LCMD   &mo 1      &kp SPACE  &kp RET    &mo 2      &kp RALT
            >;
        };

        layer_number {
            display-name = "Number";
            bindings = <
&trans          &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp BSPC
&trans          &kp LEFT        &kp UP          &kp DOWN        &kp RIGHT       &kp HOME        &kp END         &trans          &trans          &trans          &trans          &kp DEL
&trans          &trans          &trans          &trans          &trans          &kp PG_UP       &kp PG_DN       &trans          &trans          &trans          &trans          &studio_unlock
                                                &kp LCMD        &trans          &kp SPACE       &kp RET         &mo 3           &kp RALT
            >;
        };

        layer_symbol {
            display-name = "Symbol";
            bindings = <
&kp TAB               &kp EXCL              &kp AT                &kp HASH              &kp DLLR              &kp PRCNT             &kp CARET             &kp AMPS              &kp STAR              &kp LPAR              &kp RPAR              &kp BSPC
&kp LCTRL             &kp (LS(LG(LBKT)))    &kp (LS(LG(RBKT)))    &kp (LS(LG(M)))       &trans                &kp GLOBE             &kp MINUS             &kp EQUAL             &kp LBKT              &kp RBKT              &kp BSLH              &kp GRAVE
&kp LSHFT             &kp (LG(GRAVE))       &kp (LS(LG(GRAVE)))   &kp (LS(LG(A)))       &trans                &kp (LC(LS(LG(N4))))  &kp UNDER             &kp PLUS              &kp LBRC              &kp RBRC              &kp PIPE              &kp TILDE
                                                                  &kp LCMD              &mo 3                 &kp SPACE             &kp RET               &trans                &kp RALT
            >;
        };

        layer_function {
            display-name = "Function";
            bindings = <
&bt BT_SEL 0                                   &bt BT_SEL 1                                   &bt BT_SEL 2                                   &bt BT_SEL 3                                   &bt BT_SEL 4                                   &bt BT_SEL 5                                   &trans                                         &kp C_BRI_DN                                   &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x71))  &kp C_BRI_UP                                   &trans                                         &bt BT_CLR
&trans                                         &trans                                         &kp C_RW                                       &kp C_PP                                       &kp C_FF                                       &trans                                         &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x04))  &kp C_VOL_DN                                   &kp C_MUTE                                     &kp C_VOL_UP                                   &trans                                         &trans
&trans                                         &trans                                         &trans                                         &trans                                         &trans                                         &trans                                         &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0xD5))  &trans                                         &trans                                         &trans                                         &trans                                         &trans
                                                                                                                                             &trans                                         &trans                                         &trans                                         &trans                                         &trans                                         &trans
            >;
        };

        layer_spare2 {
            display-name = "SPARE2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_reserved_0 {
            display-name = "SPARE1";
            status = "reserved";
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>;
        };
    };
};
