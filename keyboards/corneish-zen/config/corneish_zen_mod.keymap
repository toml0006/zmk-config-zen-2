/*
 * Corne-ish Zen — preferred layout.
 * Snapshot of the live on-device keymap (incl. ZMK Studio edits), pulled over
 * USB via the Studio RPC protocol on 2026-09-15. Raw dump: ../zen_keymap.json.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "qwerty";
// ------------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                    | CMD | LWR | SPC |   | RET | RSE | RALT |
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R  &kp T          &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL   &kp A  &kp S  &kp D     &kp F  &kp G          &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT   &kp Z  &kp X  &kp C     &kp V  &kp B          &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                          &kp LGUI  &mo 1  &kp SPACE      &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            display-name = "Number";
// ------------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5   |   |  6   |  7  |  8  |  9  |  0  | BSPC   |
// |     | LFT |  UP | DWN | RGT | HOME |   | END  |     |     |     |     | DEL    |
// |     |     |     |     |     | PGUP |   | PGDN |     |     |     |     | UNLOCK |
//                   | CMD |     | SPC  |   | RET  | FN  | RALT |
            bindings = <
&trans  &kp N1    &kp N2  &kp N3    &kp N4     &kp N5         &kp N6     &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
&trans  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &kp HOME       &kp END    &trans  &trans  &trans  &trans  &kp DEL
&trans  &trans    &trans  &trans    &trans     &kp PG_UP      &kp PG_DN  &trans  &trans  &trans  &trans  &studio_unlock
                          &kp LGUI  &trans     &kp SPACE      &kp RET    &mo 3   &kp RALT
            >;
        };

        raise_layer {
            display-name = "Symbol";
// ------------------------------------------------------------------------------------------
// | TAB  |  !  |  @  |  #  |  $  |   %   |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL | ⌘⇧[ | ⌘⇧] | ⌘⇧M |     | GLOBE |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT | ⌘`  | ⌘⇧` | ⌘⇧A |     | ⌃⌘⇧4  |   |  _  |  +  |  {  |  }  |  |  |  ~   |
//                    | CMD | FN  |  SPC  |   | RET |     | RALT |
            bindings = <
&kp TAB    &kp EXCL          &kp AT             &kp HASH       &kp DLLR  &kp PRCNT            &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &kp LG(LS(LBKT))  &kp LG(LS(RBKT))   &kp LG(LS(M))  &trans    &kp GLOBE            &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &kp LG(GRAVE)     &kp LG(LS(GRAVE))  &kp LG(LS(A))  &trans    &kp LC(LS(LG(N4)))   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                                &kp LGUI       &mo 3     &kp SPACE            &kp RET    &trans     &kp RALT
            >;
        };

        fn_layer {
            display-name = "Function";
// ------------------------------------------------------------------------------------------
// | BT0 | BT1 | BT2 | BT3 | BT4 | BT5 |   |      | BRI- | BRI  | BRI+ |     | BTCLR |
// |     |     |  ⏮  |  ⏯  |  ⏭  |     |   | MIC  | VOL- | MUTE | VOL+ |     |       |
// |     |     |     |     |     |     |   | DICT |      |      |      |     |       |
// BRI = consumer 0x71 (absolute Display Brightness), MIC = 0x04, DICT = 0xD5 (mic capture).
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5    &trans                                         &kp C_BRI_DEC  &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x71))  &kp C_BRI_INC  &trans  &bt BT_CLR
&trans        &trans        &kp C_RW      &kp C_PP      &kp C_FF      &trans          &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0x04))  &kp C_VOL_DN   &kp C_MUTE                                     &kp C_VOL_UP   &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans          &kp (ZMK_HID_USAGE(HID_USAGE_CONSUMER, 0xD5))  &trans         &trans                                         &trans         &trans  &trans
                                          &trans        &trans        &trans          &trans                                         &trans         &trans
            >;
        };

        spare2_layer {
            display-name = "SPARE2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        // Removed via Studio on the device; kept reserved so Studio can add a layer back.
        spare1_layer {
            display-name = "SPARE1";
            status = "reserved";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };
    };
};
